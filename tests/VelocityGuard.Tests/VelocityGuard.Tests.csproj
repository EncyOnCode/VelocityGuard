<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>VelocityGuard.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    The core is linked as source rather than referenced as an assembly. A project reference would
    drag in OpenTabletDriver.Plugin, whose runtime assets are excluded by design, and would force
    the tests to construct ITabletReport instances just to exercise arithmetic.
  -->
  <ItemGroup>
    <Compile Include="../../VelocityGuardCore.cs" Link="Core/VelocityGuardCore.cs" />
    <Compile Include="../../VelocityGuardSettings.cs" Link="Core/VelocityGuardSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
